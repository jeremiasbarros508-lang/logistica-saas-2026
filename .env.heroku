# =============================================================================
# Variáveis de ambiente para produção no Heroku
# =============================================================================
# ATENÇÃO: Este arquivo é um EXEMPLO de referência.
# NÃO use este arquivo diretamente.
# Configure as variáveis com: heroku config:set KEY=VALUE
# =============================================================================

# Ambiente de execução
ENVIRONMENT=production

# Nível de log
LOG_LEVEL=info

# Banco de dados (configurado automaticamente pelo add-on heroku-postgresql)
# NÃO configure manualmente — o Heroku injeta esta variável automaticamente
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (configurado automaticamente pelo add-on heroku-redis, se usado)
# NÃO configure manualmente — o Heroku injeta esta variável automaticamente
REDIS_URL=redis://h:password@host:6379

# JWT Secret — GERE UM VALOR ALEATÓRIO E SEGURO
# Execute: openssl rand -hex 32
# ATENÇÃO: Substitua antes do deploy. Nunca use este valor em produção!
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32

# URLs do app (substitua pelo nome real do seu app no Heroku)
FRONTEND_URL=https://seu-app-heroku.herokuapp.com
BACKEND_URL=https://seu-app-heroku.herokuapp.com/api

# =============================================================================
# Como configurar no Heroku via CLI:
#
# heroku config:set \
#   JWT_SECRET=$(openssl rand -hex 32) \
#   ENVIRONMENT=production \
#   LOG_LEVEL=info \
#   FRONTEND_URL=https://seu-app-heroku.herokuapp.com \
#   BACKEND_URL=https://seu-app-heroku.herokuapp.com/api \
#   --app seu-app-heroku
#
# DATABASE_URL e REDIS_URL são injetados automaticamente pelos add-ons.
# =============================================================================
