# Environment Variables Template – Tech Logistics
# Copy this file to .env and fill in your values

# Flask environment: development, testing, or production
FLASK_ENV=development

# Secret key for session signing (generate a strong random string)
SECRET_KEY=your-secret-key-here

# JWT secret (if using JWT auth)
JWT_SECRET_KEY=your-jwt-secret-here

# Database URL (PostgreSQL for production, SQLite for development)
# Heroku sets this automatically when you add the Heroku Postgres add-on
DATABASE_URL=postgresql://user:password@localhost:5432/logistics

# Mail settings (optional – required for password reset emails)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@techlogistics.com

# Port (Heroku sets this automatically)
PORT=5000
